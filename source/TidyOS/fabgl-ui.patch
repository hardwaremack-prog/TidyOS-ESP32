+// (TidyOS) a window's "destroy" event must never be lost: a full queue (e.g. a burst of mouse
+// moves from the browser) used to drop it, and the whole window then stayed in memory
+static uiEvent s_pendDestroy[48];
+static int     s_pendDestroyN = 0;
+
 bool uiApp::getEvent(uiEvent * event, int timeOutMS)
 {
+  while (s_pendDestroyN > 0 && xQueueSendToBack(m_eventsQueue, &s_pendDestroy[0], 0) == pdTRUE) {
+    for (int i = 1; i < s_pendDestroyN; ++i) s_pendDestroy[i - 1] = s_pendDestroy[i];
+    --s_pendDestroyN;
+  }
   return xQueueReceive(m_eventsQueue, event,  msToTicks(timeOutMS)) == pdTRUE;
 }
 
