     uiEvent evt = uiEvent(window, UIEVT_DESTROY);
-    postEvent(&evt);
+    if (!postEvent(&evt) && s_pendDestroyN < 48) s_pendDestroy[s_pendDestroyN++] = evt;   // queue full: send it later
   }
 }
 
