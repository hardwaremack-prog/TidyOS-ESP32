   Rect barRect = titleBarRect();
   Rect btnRect = Rect(barRect.X2 - btnSize - CORNERSENSE / 2, barRect.Y1,
                       barRect.X2 - CORNERSENSE / 2, barRect.Y2);
-  while (buttonIndex--)
