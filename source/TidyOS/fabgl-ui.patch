 // uiEvtHandler
 
 
+// TidyOS patch: remember recently deleted handlers so events still queued for them are dropped
+// (otherwise run() calls into freed memory - a crash at PC 0)
+static void * s_deadHandlers[64];
+static int    s_deadPos = 0;
+bool fabglHandlerIsDead(void * h)
+{
+  for (auto d : s_deadHandlers) if (d == h) return true;
+  return false;
+}
+
 uiEvtHandler::uiEvtHandler(uiApp * app)
   : m_app(app)
 {
   objectType().uiEvtHandler = true;
+  for (auto & d : s_deadHandlers) if (d == this) d = nullptr;     // this address is alive again
 }
 
 
@@ -185,6 +196,8 @@ uiEvtHandler::~uiEvtHandler()
 {
   if (m_app)
     m_app->killEvtHandlerTimers(this);
+  s_deadHandlers[s_deadPos] = this;
+  s_deadPos = (s_deadPos + 1) % 64;
 }
 
 
